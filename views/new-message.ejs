<%- include("partials/header", { pageTitle: "New message" }) %>
<section class="form-page form-page-wide">
  <p class="eyebrow">Noticeboard</p>
  <h1>Write a message</h1>
  <form class="form-stack" action="/messages/new" method="post">
    <% if (errors && errors.length) { %>
      <div class="error-list" role="alert">
        <% errors.forEach((error) => { %><p><%= error.msg %></p><% }) %>
      </div>
    <% } %>
    <label>Title
      <input name="title" required maxlength="120" value="<%= formData.title || '' %>">
    </label>
    <label>Message
      <textarea name="text" rows="8" required maxlength="10000"><%= formData.text || '' %></textarea>
    </label>
    <div class="form-actions">
      <a class="text-link" href="/">Cancel</a>
      <button class="button" type="submit">Post message</button>
    </div>
  </form>
</section>
<%- include("partials/footer") %>
