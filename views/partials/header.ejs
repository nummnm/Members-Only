<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= pageTitle %> | Members Only</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/layout.css">
  <link rel="stylesheet" href="/css/messages.css">
  <link rel="stylesheet" href="/css/forms.css">
  <link rel="stylesheet" href="/css/profile.css">
  <script src="/js/forms.js" defer></script>
</head>
<body>
  <header class="site-header">
    <nav class="site-nav" aria-label="Main navigation">
      <a href="/">Messages</a>
      <% if (typeof user !== "undefined" && user) { %>
        <% if (!user.membership_status && !user.is_admin) { %>
          <a href="/join-club">Join the club</a>
        <% } %>
        <% if (!user.is_admin) { %>
          <a href="/join-admin">Admin passcode</a>
        <% } %>
      <% } %>
    </nav>
    <a class="brand" href="/">Members Only</a>
    <div class="account-nav">
      <% if (typeof user !== "undefined" && user) { %>
        <a class="profile-link" href="/profile" aria-label="Open <%= user.first_name %>'s profile">
          <% if (user.profile_icon) { %>
            <img class="profile-avatar" src="<%= user.profile_icon %>" alt="">
          <% } else { %>
            <span class="profile-avatar" aria-hidden="true"><%= user.first_name.charAt(0).toUpperCase() %><%= user.last_name.charAt(0).toUpperCase() %></span>
          <% } %>
        </a>
      <% } else { %>
        <a href="/login">Log in</a>
        <a class="nav-signup" href="/signup">Sign up</a>
      <% } %>
    </div>
  </header>
  <main class="page-shell">
